generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  name         String
  role         String             @default("MATCHMAKER")
  avatarUrl    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  notes        CustomerNote[]
  followUps    FollowUp[]
  sentMatches  MatchInteraction[]
  activities   ActivityLog[]
}

model CustomerProfile {
  id                  String             @id @default(cuid())
  customerCode        String             @unique
  firstName           String
  lastName            String
  gender              String
  dateOfBirth         DateTime
  heightCm            Int
  email               String
  phone               String
  city                String
  state               String
  country             String             @default("India")
  maritalStatus       String
  profilePhotoUrl     String?
  isVerified          Boolean            @default(false)
  verificationNotes   String?

  undergraduateCollege String?
  degree               String?
  highestEducation     String
  currentCompany       String?
  designation          String?
  industry             String?
  employmentType       String?
  annualIncome         Float?
  incomeCurrency       String             @default("INR")

  religion            String
  caste               String?
  motherTongue        String
  otherLanguages      String?
  familyType          String?
  familyValues        String?
  familyLocation      String?
  fatherOccupation    String?
  motherOccupation    String?
  siblingsCount       Int                @default(0)
  siblingDetails      String?

  wantChildren        String
  openToRelocate      String
  openToPets          String
  diet                String
  smoking             String?
  drinking            String?
  hobbies             String?
  marriageTimeline    String?
  relationshipExpectations String?
  familyExpectations       String?

  journeyStage        String             @default("NEW_LEAD")
  profileCompleteness Int                @default(80)
  assignedMatchmakerId String?
  lastContactedAt     DateTime?
  nextFollowUpDate    DateTime?
  internalNotes       String?
  isArchived          Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  partnerPreference   PartnerPreference?
  notes               CustomerNote[]
  followUps           FollowUp[]
  recommendationsAsFocal     MatchRecommendation[] @relation("FocalCustomer")
  recommendationsAsCandidate MatchRecommendation[] @relation("CandidateCustomer")
  sentMatchesAsCustomerA    MatchInteraction[]    @relation("CustomerA")
  sentMatchesAsCustomerB    MatchInteraction[]    @relation("CustomerB")
  activityLogs        ActivityLog[]
}

model PartnerPreference {
  id                      String          @id @default(cuid())
  customerId              String          @unique
  customer                CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  minAge                  Int?
  maxAge                  Int?
  minHeightCm             Int?
  maxHeightCm             Int?
  preferredCities         String?
  preferredEducation      String?
  preferredProfessions    String?
  maritalStatusPreferences String?
  wantChildrenPreference  String?
  openToRelocatePreference String?
  dietPreferences         String?
  religionPreferences     String?
  dealbreakers            String?
  flexiblePreferences     String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

model MatchRecommendation {
  id                 String          @id @default(cuid())
  customerId         String
  customer           CustomerProfile @relation("FocalCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  candidateId        String
  candidate          CustomerProfile @relation("CandidateCustomer", fields: [candidateId], references: [id], onDelete: Cascade)
  compatibilityScore Float
  tier               String
  scoreBreakdown     String
  customerScoreAtoB  Float
  candidateScoreBtoA Float
  sharedPreferences  String
  potentialConflicts String
  missingAttributes  String
  explanationText    String
  algorithmVersion   String          @default("v1.0.0")
  status             String          @default("SUGGESTED")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  interactions       MatchInteraction[]

  @@unique([customerId, candidateId])
}

model MatchInteraction {
  id                    String               @id @default(cuid())
  matchRecommendationId String?
  recommendation        MatchRecommendation? @relation(fields: [matchRecommendationId], references: [id], onDelete: SetNull)
  customerAId           String
  customerA             CustomerProfile      @relation("CustomerA", fields: [customerAId], references: [id], onDelete: Cascade)
  customerBId           String
  customerB             CustomerProfile      @relation("CustomerB", fields: [customerBId], references: [id], onDelete: Cascade)
  senderId              String
  sender                User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  subject               String
  introductionMessage   String
  status                String               @default("SENT")
  statusHistory         String
  sentAt                DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([customerAId, customerBId])
}

model CustomerNote {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String
  author     User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  noteType   String          @default("GENERAL")
  content    String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model FollowUp {
  id           String          @id @default(cuid())
  customerId   String
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  matchmakerId String
  matchmaker   User            @relation(fields: [matchmakerId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  dueDate      DateTime
  priority     String          @default("MEDIUM")
  status       String          @default("PENDING")
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ActivityLog {
  id         String           @id @default(cuid())
  customerId String?
  customer   CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType String
  title      String
  details    String?
  createdAt  DateTime         @default(now())
}
