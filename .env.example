# Database Connection
# For local zero-configuration SQLite development:
DATABASE_URL="file:./dev.db"

# For hosted PostgreSQL (Neon, Supabase, AWS RDS, Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/tdc_matchmaker?sslmode=require"

# Session & Authentication Secret (Generate a 32+ character random secret in production)
JWT_SECRET="tdc-matchmaker-development-jwt-session-secret-change-in-production"

# AI Integration (Optional: The application deterministically falls back if this is omitted or times out)
OPENAI_API_KEY=""

# Application Environment
NODE_ENV="development"
