# Database Connection
# For local zero-configuration SQLite development:
DATABASE_URL="file:./dev.db"

# For hosted PostgreSQL (Neon, Supabase, AWS RDS, Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/tdc_matchmaker?sslmode=require"

# Session & Authentication Secret (Generate a 32+ character random secret in production)
JWT_SECRET="tdc-matchmaker-development-jwt-session-secret-change-in-production"

# AI Integration: Powered by Google Gemini API (gemini-3.0-flash)
# Google Gemini API is utilized as the primary LLM provider because OpenAI API is paid.
# If omitted or offline, the platform automatically runs deterministic mathematical rules without error.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.0-flash"

# Application Environment
NODE_ENV="development"

